# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Student Chat ID (required for daily check at 20:00)
# To get your chat ID: Send a message to the bot, then visit:
# https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
STUDENT_CHAT_ID=0

# Parent Chat ID (optional - for notifications about reminders and student responses)
PARENT_CHAT_ID=0

# Data Directory (where user settings will be stored)
DATA_DIR=data

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
